#!/usr/bin/env bash
# cg-tmux — the tmux extension's launcher. cg start runs it as
#
#   cg-tmux launch -- <agent> [agent args…]
#
# and it starts the agent inside a new tmux session named after the agent,
# the directory and the time, using the extension's tmux.conf when it starts
# the tmux server. Inside tmux already, or without tmux, it runs the agent
# directly (with a warning when tmux is missing), so cg start always starts
# the session.
set -u

usage() {
  echo "usage: cg-tmux launch -- <agent> [args…]" >&2
  exit 2
}

[ "${1:-}" = launch ] || usage
shift
[ "${1:-}" = -- ] || usage
shift
[ $# -ge 1 ] || usage

if [ -n "${TMUX:-}" ]; then
  exec "$@"
fi

tmux_bin=${CG_TMUX_BIN:-tmux}
if ! command -v "$tmux_bin" >/dev/null 2>&1; then
  echo "cg-tmux: tmux not found; starting $1 without it (install tmux, e.g. brew install tmux)" >&2
  exec "$@"
fi

here=$(cd "$(dirname "$0")/.." && pwd)
conf="$here/tmux.conf"

# tmux session names may not contain '.' or ':'.
clean() { printf '%s' "$1" | tr -c 'A-Za-z0-9_-' '-' | cut -c1-30; }
name="$(clean "$(basename "$1")")-$(clean "$(basename "$PWD")")-$(date +%H%M%S)"

exec "$tmux_bin" -f "$conf" new-session -s "$name" -c "$PWD" -- "$@"
