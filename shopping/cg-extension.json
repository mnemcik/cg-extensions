{
  "manifest": 2,
  "name": "shopping",
  "version": "0.3.0",
  "description": "One shared shopping list for the workspace — any project adds items, open items group by supplier so one order covers every project; one file per item, so parallel sessions never conflict (cg shop)",
  "contributes": {
    "claude-md-sections": [
      { "id": "shopping", "path": "fragments/shopping.md" }
    ],
    "notes": [
      { "src": "notes/shopping-list-workflow.md", "dest": "notes/shopping-list-workflow.md" }
    ],
    "templates": [
      { "src": "templates/shopping-item.md", "dest": "templates/shopping-item.md" }
    ],
    "commands": [
      { "command": "shop",         "binary": "cg-shop" },
      { "command": "shop add",     "binary": "cg-shop" },
      { "command": "shop list",    "binary": "cg-shop" },
      { "command": "shop order",   "binary": "cg-shop" },
      { "command": "shop receive", "binary": "cg-shop" },
      { "command": "shop cancel",  "binary": "cg-shop" },
      { "command": "shop show",    "binary": "cg-shop" }
    ]
  }
}
