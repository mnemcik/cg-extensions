#!/usr/bin/env bash
# cg shop — a shared shopping list for a Consigliere workspace.
#
# Every item is one markdown file, shopping/<id>.md at the root of the current
# git work tree, with its fields in YAML frontmatter. A new item is a new file,
# so parallel sessions in separate worktrees never conflict when they land; a
# status change edits only that item's file. Views (grouped by supplier or
# project) are computed when read, never stored.
#
# Portable bash 3.2+ with POSIX awk/sed/sort only (macOS and Linux, Git Bash).

set -u

VERSION="0.1.0"
STATUSES="needed ordered received cancelled"

die()   { printf 'cg shop: %s\n' "$*" >&2; exit 1; }
usage_die() { printf 'cg shop: %s\n' "$*" >&2; printf "Run 'cg shop help' for usage.\n" >&2; exit 2; }

today() {
  if [ -n "${CG_SHOP_TODAY:-}" ]; then printf '%s\n' "$CG_SHOP_TODAY"; else date +%Y-%m-%d; fi
}

# init_dir: set SHOP_DIR to the shopping/ folder of the current work tree
# (CG_SHOP_DIR overrides). Runs once in the main shell, so a failure exits.
SHOP_DIR=""
init_dir() {
  if [ -n "${CG_SHOP_DIR:-}" ]; then SHOP_DIR=$CG_SHOP_DIR; return; fi
  local top
  top=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git work tree (run it from your workspace)"
  SHOP_DIR="$top/shopping"
}
shop_dir() { printf '%s\n' "$SHOP_DIR"; }

# slugify: lowercase, every run of non-[a-z0-9] becomes one '-', trimmed, max 50 chars.
slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | LC_ALL=C sed -e 's/[^a-z0-9]\{1,\}/-/g' -e 's/^-//' -e 's/-$//' | cut -c1-50 | sed -e 's/-$//'
}

# yq_str: a YAML double-quoted scalar.
yq_str() {
  local v=$1
  v=${v//\\/\\\\}
  v=${v//\"/\\\"}
  printf '"%s"' "$v"
}

# oneline: tabs, CRs and newlines become spaces (keeps ids and frontmatter one-line).
oneline() { printf '%s' "$1" | tr '\t\r\n' '   '; }

# rand_hex: 6 hex digits, from /dev/urandom when available.
rand_hex() {
  local h=""
  [ -r /dev/urandom ] && h=$(od -An -N3 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')
  [ "${#h}" -eq 6 ] || h=$(printf '%03x%03x' $((RANDOM % 4096)) $((RANDOM % 4096)))
  printf '%s\n' "$h"
}

valid_date() { printf '%s' "$1" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'; }

# records FILE... — one TSV line per item. The reader handles what cg shop writes
# plus simple hand edits (unquoted or single-quoted values, extra keys, CRLF); it is
# not a full YAML parser (no comments after values, no multi-line scalars).
# Columns:
#   id status supplier qty project part title order_ref added needed_by ordered received link mpn price
records() {
  [ "$#" -gt 0 ] || return 0
  awk -v q="'" '
    function unq(v) {
      sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v)
      if (v ~ /^".*"$/) {
        v = substr(v, 2, length(v) - 2)
        out = ""
        while ((i = index(v, "\\")) > 0) {
          out = out substr(v, 1, i - 1) substr(v, i + 1, 1)
          v = substr(v, i + 2)
        }
        v = out v
      } else if (substr(v, 1, 1) == q && substr(v, length(v), 1) == q && length(v) >= 2) {
        v = substr(v, 2, length(v) - 2)
      }
      gsub(/\t/, " ", v)
      return v
    }
    function flush() {
      if (fname == "") return
      id = fname; sub(/^.*\//, "", id); sub(/\.md$/, "", id)
      printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", id, f["status"], f["supplier"], f["qty"], f["project"], f["part"], f["title"], f["order_ref"], f["added"], f["needed_by"], f["ordered"], f["received"], f["link"], f["mpn"], f["price"]
    }
    { sub(/\r$/, "") }
    FNR == 1 { flush(); delete f; fname = FILENAME; state = 0 }
    state == 0 { if ($0 ~ /^---[ \t]*$/) { state = 1; next } else { state = 2 } }
    state == 1 {
      if ($0 ~ /^---[ \t]*$/) { state = 2; next }
      if (match($0, /^[A-Za-z_][A-Za-z0-9_]*:/)) {
        k = substr($0, 1, RLENGTH - 1)
        f[k] = unq(substr($0, RLENGTH + 1))
      }
    }
    END { flush() }
  ' "$@"
}

all_records() {
  local dir; dir=$(shop_dir)
  [ -d "$dir" ] || return 0
  set -- "$dir"/*.md
  [ -e "$1" ] || return 0
  records "$@"
}

# resolve_id ID-OR-PREFIX — prints the full id of exactly one item.
resolve_id() {
  local want=$1 dir matches n
  case "$want" in
    ''|.*|*[!A-Za-z0-9._-]*) die "'$want' is not an item id (ids use only letters, digits, '.', '_' and '-')" ;;
  esac
  dir=$(shop_dir)
  if [ -f "$dir/$want.md" ]; then printf '%s\n' "$want"; return; fi
  matches=$(all_records | cut -f1 | P="$want" awk 'index($0, ENVIRON["P"]) == 1')
  n=$(printf '%s' "$matches" | grep -c . || true)
  [ "$n" -eq 1 ] || {
    [ "$n" -eq 0 ] && die "no item matches '$want'"
    die "'$want' matches $n items: $(printf '%s' "$matches" | tr '\n' ' ')"
  }
  printf '%s\n' "$matches"
}

# set_fields FILE key=value... — set (or add) frontmatter keys, in place.
# An empty value removes the key. qty and date keys are written bare; the rest quoted.
set_fields() {
  local file=$1; shift
  local spec="" kv k v
  for kv in "$@"; do
    k=${kv%%=*}; v=${kv#*=}
    case "$k" in
      status|qty|added|ordered|received|needed_by) ;;
      *) [ -n "$v" ] && v=$(yq_str "$v") ;;
    esac
    spec="$spec$k=$v"$'\n'
  done
  local tmp="$file.tmp.$$"
  SPEC="$spec" awk '
    BEGIN {
      n = split(ENVIRON["SPEC"], lines, "\n")
      for (i = 1; i <= n; i++) {
        if (lines[i] == "") continue
        j = index(lines[i], "=")
        k = substr(lines[i], 1, j - 1)
        val[k] = substr(lines[i], j + 1); order[++cnt] = k
      }
    }
    { sub(/\r$/, "") }
    NR == 1 && /^---[ \t]*$/ { print; fm = 1; next }
    fm == 1 && /^---[ \t]*$/ {
      for (i = 1; i <= cnt; i++) { k = order[i]; if (!(k in done) && val[k] != "") print k ": " val[k] }
      print; fm = 2; next
    }
    fm == 1 && match($0, /^[A-Za-z_][A-Za-z0-9_]*:/) {
      k = substr($0, 1, RLENGTH - 1)
      if (k in val) { if (!(k in done)) { done[k] = 1; if (val[k] != "") print k ": " val[k] } ; next }
    }
    { print }
    END { if (fm != 2) exit 3 }
  ' "$file" >"$tmp"
  local rc=$?
  if [ "$rc" -eq 3 ]; then rm -f "$tmp"; die "$file has no frontmatter block (--- ... ---); fix it by hand"; fi
  [ "$rc" -eq 0 ] && mv "$tmp" "$file" || { rm -f "$tmp"; die "could not update $file"; }
}

# ---------------------------------------------------------------- commands

cmd_add() {
  local title="" supplier="" qty=1 project="" part="" mpn="" link="" price="" needed_by="" note=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --supplier|-s) supplier=${2-}; shift 2 || usage_die "--supplier needs a value" ;;
      --qty|-q)      qty=${2-}; shift 2 || usage_die "--qty needs a value" ;;
      --project|-p)  project=${2-}; shift 2 || usage_die "--project needs a value" ;;
      --part)        part=${2-}; shift 2 || usage_die "--part needs a value" ;;
      --mpn)         mpn=${2-}; shift 2 || usage_die "--mpn needs a value" ;;
      --link)        link=${2-}; shift 2 || usage_die "--link needs a value" ;;
      --price)       price=${2-}; shift 2 || usage_die "--price needs a value" ;;
      --needed-by)   needed_by=${2-}; shift 2 || usage_die "--needed-by needs a value" ;;
      --note)        note=${2-}; shift 2 || usage_die "--note needs a value" ;;
      --) shift; title="$title${title:+ }$*"; break ;;
      -*) usage_die "add: unknown option $1" ;;
      *) title="$title${title:+ }$1"; shift ;;
    esac
  done
  title=$(oneline "$title"); supplier=$(oneline "$supplier"); project=$(oneline "$project")
  part=$(oneline "$part"); mpn=$(oneline "$mpn"); link=$(oneline "$link"); price=$(oneline "$price")
  case "$title" in *[!\ ]*) ;; *) title="" ;; esac
  [ -n "$title" ] || usage_die "add: what to buy is required, e.g. cg shop add \"ESP32-C6 module\" --supplier lcsc"
  [ -n "$supplier" ] || usage_die "add: --supplier is required"
  printf '%s' "$qty" | grep -Eq '^[1-9][0-9]*$' || usage_die "add: --qty must be a positive whole number, got '$qty'"
  [ -z "$needed_by" ] || valid_date "$needed_by" || usage_die "add: --needed-by must be YYYY-MM-DD, got '$needed_by'"
  local sup; sup=$(slugify "$supplier"); [ -n "$sup" ] || usage_die "add: supplier '$supplier' has no letters or digits"
  [ -z "$project" ] || project=$(slugify "$project")

  local dir date slug id
  dir=$(shop_dir); date=$(today)
  slug=$(slugify "$title"); [ -n "$slug" ] || slug=item
  # The random suffix is always there: two worktrees adding the same item on the
  # same day must still create different files, or their lands conflict.
  mkdir -p "$dir" || die "cannot create $dir"
  id="$date-$slug-$(rand_hex)"
  while [ -e "$dir/$id.md" ]; do id="$date-$slug-$(rand_hex)"; done

  {
    printf -- '---\n'
    printf 'title: %s\n' "$(yq_str "$title")"
    printf 'status: needed\n'
    printf 'supplier: %s\n' "$(yq_str "$sup")"
    printf 'qty: %s\n' "$qty"
    [ -n "$project" ]   && printf 'project: %s\n' "$(yq_str "$project")"
    [ -n "$part" ]      && printf 'part: %s\n' "$(yq_str "$part")"
    [ -n "$mpn" ]       && printf 'mpn: %s\n' "$(yq_str "$mpn")"
    [ -n "$link" ]      && printf 'link: %s\n' "$(yq_str "$link")"
    [ -n "$price" ]     && printf 'price: %s\n' "$(yq_str "$price")"
    [ -n "$needed_by" ] && printf 'needed_by: %s\n' "$needed_by"
    printf 'added: %s\n' "$date"
    printf -- '---\n'
    if [ -n "$note" ]; then printf '\n%s\n' "$note"; fi
  } >"$dir/$id.md" || die "cannot write $dir/$id.md"

  printf 'added %s\n' "$id"
  printf '  %s\n' "$dir/$id.md"
}

cmd_list() {
  local status=open supplier="" project="" by=supplier format=text
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --status)      status=${2-}; shift 2 || usage_die "--status needs a value" ;;
      --all|-a)      status=all; shift ;;
      --supplier|-s) [ "$#" -ge 2 ] || usage_die "--supplier needs a value"; supplier=$(slugify "$2"); [ -n "$supplier" ] || usage_die "list: supplier '$2' has no letters or digits"; shift 2 ;;
      --project|-p)  [ "$#" -ge 2 ] || usage_die "--project needs a value"; project=$(slugify "$2"); [ -n "$project" ] || usage_die "list: project '$2' has no letters or digits"; shift 2 ;;
      --by)          by=${2-}; shift 2 || usage_die "--by needs a value" ;;
      --tsv)         format=tsv; shift ;;
      *) usage_die "list: unknown argument $1" ;;
    esac
  done
  case "$by" in supplier|project|none) ;; *) usage_die "list: --by must be supplier, project or none" ;; esac
  case " open all $STATUSES " in *" $status "*) ;; *) usage_die "list: --status must be open, all, or one of: $STATUSES" ;; esac

  local rows
  rows=$(all_records | ST="$status" SUP="$supplier" PRJ="$project" awk -F'\t' '
    BEGIN { st = ENVIRON["ST"]; sup = ENVIRON["SUP"]; prj = ENVIRON["PRJ"] }
    (st == "all" || (st == "open" && ($2 == "needed" || $2 == "ordered")) || $2 == st) &&
    (sup == "" || $3 == sup) && (prj == "" || $5 == prj)')

  if [ "$format" = tsv ]; then
    printf 'id\tstatus\tsupplier\tqty\tproject\tpart\ttitle\torder_ref\tadded\tneeded_by\tordered\treceived\tlink\tmpn\tprice\n'
    [ -n "$rows" ] && printf '%s\n' "$rows"
    return 0
  fi
  if [ -z "$rows" ]; then echo "No items."; return 0; fi

  printf '%s\n' "$rows" | awk -F'\t' -v by="$by" '
    function rank(s) { return s == "needed" ? 1 : s == "ordered" ? 2 : s == "received" ? 3 : s == "cancelled" ? 4 : 5 }
    { key = (by == "supplier") ? ($3 == "" ? "(no supplier)" : $3) : (by == "project") ? ($5 == "" ? "(no project)" : $5) : ""
      printf "%s\t%d\t%s\t%s\n", key, rank($2), $9, $0 }' |
  LC_ALL=C sort -t "$(printf '\t')" -k1,1 -k2,2n -k3,3 |
  cut -f4- |
  awk -F'\t' -v by="$by" '
    BEGIN { split("needed ordered received cancelled", st, " ") }
    function header() {
      if (by == "none" || cur == "") return
      s = ""
      for (r = 1; r <= 4; r++) { k = st[r]; if (k in cnt) { s = s (s == "" ? "" : ", ") cnt[k] " " k; delete cnt[k] } }
      for (k in cnt) s = s (s == "" ? "" : ", ") cnt[k] " " (k == "" ? "no status" : k)
      printf "%s%s (%s)\n", (printed++ ? "\n" : ""), cur, s
      for (i = 1; i <= n; i++) print lines[i]
      delete cnt; n = 0
    }
    {
      key = (by == "supplier") ? ($3 == "" ? "(no supplier)" : $3) : (by == "project") ? ($5 == "" ? "(no project)" : $5) : ""
      if (key != cur) { header(); cur = key }
      other = (by == "supplier") ? $5 : $3
      extra = ""
      if ($6 != "") extra = extra "  [" $6 "]"
      if ($8 != "") extra = extra "  order " $8
      if ($10 != "" && ($2 == "needed" || $2 == "ordered")) extra = extra "  by " $10
      line = sprintf("  %-9s %4s x %s%s  %s  %s", $2, $4, $7, extra, (other == "" ? "-" : other), $1)
      if (by == "none") print line; else { lines[++n] = line; cnt[$2]++ }
    }
    END { header() }'
}

# order SUPPLIER [--ref R] [ID...]: needed items from SUPPLIER become ordered.
cmd_order() {
  local supplier="" ref="" ids=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --ref|-r) ref=${2-}; shift 2 || usage_die "--ref needs a value" ;;
      -*) usage_die "order: unknown option $1" ;;
      *) if [ -z "$supplier" ]; then supplier=$(slugify "$1"); [ -n "$supplier" ] || usage_die "order: supplier '$1' has no letters or digits"; else ids="$ids $(resolve_id "$1")" || exit 1; fi; shift ;;
    esac
  done
  [ -n "$supplier" ] || usage_die "order: name the supplier, e.g. cg shop order lcsc --ref LC2611130001"
  local dir date targets id n=0
  dir=$(shop_dir); date=$(today)
  targets=$(all_records | SUP="$supplier" awk -F'\t' '$2 == "needed" && $3 == ENVIRON["SUP"] { print $1 }')
  if [ -n "$ids" ]; then
    for id in $ids; do
      printf '%s\n' "$targets" | grep -qxF -- "$id" || die "$id is not a needed item from $supplier"
    done
    targets=$(printf '%s\n' $ids)
  fi
  [ -n "$targets" ] || die "nothing needed from $supplier"
  for id in $targets; do
    set_fields "$dir/$id.md" status=ordered ordered="$date" order_ref="$ref"
    printf 'ordered %s\n' "$id"; n=$((n + 1))
  done
  printf '%d item(s) from %s marked ordered%s\n' "$n" "$supplier" "${ref:+ (order $ref)}"
}

# close_items STATUS ARGS... — shared by receive and cancel.
close_items() {
  local to=$1; shift
  local ref="" ids="" id
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --ref|-r) [ "$to" = received ] || usage_die "cancel takes item ids, not --ref"; ref=${2-}; shift 2 || usage_die "--ref needs a value" ;;
      -*) usage_die "unknown option $1" ;;
      *) ids="$ids $(resolve_id "$1")" || exit 1; shift ;;
    esac
  done
  if [ -n "$ref" ]; then
    ids="$ids $(all_records | REF="$ref" awk -F'\t' '$2 == "ordered" && $8 == ENVIRON["REF"] { print $1 }')"
    [ -n "${ids// /}" ] || die "no ordered items with order ref '$ref'"
  fi
  if [ -z "${ids// /}" ]; then
    if [ "$to" = received ]; then usage_die "receive: name the item id(s), or --ref <order no>"; else usage_die "cancel: name the item id(s)"; fi
  fi
  local dir date cur n=0
  dir=$(shop_dir); date=$(today)
  for id in $ids; do
    cur=$(records "$dir/$id.md" | cut -f2)
    case "$to:$cur" in
      received:received|cancelled:cancelled) printf 'already %s: %s\n' "$cur" "$id"; continue ;;
      received:cancelled) die "$id is cancelled; it cannot be received" ;;
      cancelled:received) die "$id is already received; it cannot be cancelled" ;;
    esac
    if [ "$to" = received ]; then
      set_fields "$dir/$id.md" status=received received="$date"
    else
      set_fields "$dir/$id.md" status=cancelled
    fi
    printf '%s %s\n' "$to" "$id"; n=$((n + 1))
  done
}

cmd_show() {
  [ "$#" -eq 1 ] || usage_die "show: give one item id"
  local id; id=$(resolve_id "$1") || exit 1
  local f; f="$(shop_dir)/$id.md"
  printf '%s\n\n' "$f"; cat "$f"
}

cmd_help() {
  cat <<'EOF'
cg shop — one shared shopping list for the workspace

Items are files in shopping/<id>.md at the root of the current work tree, so
commit them with the rest of your session's work.

Usage:
  cg shop add <what> --supplier <s> [--qty N] [--project <slug>]
              [--part <supplier part no>] [--mpn <manufacturer part no>]
              [--link <url>] [--price <text>] [--needed-by YYYY-MM-DD] [--note <text>]
  cg shop list [--status open|all|needed|ordered|received|cancelled] [--all]
               [--supplier <s>] [--project <slug>] [--by supplier|project|none] [--tsv]
               (default: open items — needed and ordered — grouped by supplier)
  cg shop order <supplier> [--ref <order no>] [<id>...]
               mark every needed item from <supplier> ordered (or only the ids given)
  cg shop receive <id>... | --ref <order no>
  cg shop cancel <id>...
  cg shop show <id>
  cg shop version

Ids can be shortened to any unique prefix. In add, everything after -- is
taken as the title, so a title can start with a dash. Supplier and project names are
normalised to slugs ("LCSC" and "lcsc" are the same supplier).

Exit codes: 0 ok, 1 error, 2 usage.
EOF
}

main() {
  local cmd=${1-help}; [ "$#" -gt 0 ] && shift
  case "$cmd" in
    add|list|ls|order|receive|cancel|show) init_dir ;;
  esac
  case "$cmd" in
    add)          cmd_add "$@" ;;
    list|ls)      cmd_list "$@" ;;
    order)        cmd_order "$@" ;;
    receive)      close_items received "$@" ;;
    cancel)       close_items cancelled "$@" ;;
    show)         cmd_show "$@" ;;
    version|--version) printf 'cg-shop %s\n' "$VERSION" ;;
    help|-h|--help) cmd_help ;;
    *) usage_die "unknown command '$cmd'" ;;
  esac
}

main "$@"
