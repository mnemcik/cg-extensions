filters:
  and:
    - file.inFolder("projects")
    - file.path.endsWith("/README.md")
    - status != "done"
properties:
  note.title:
    displayName: Project
  note.status:
    displayName: Status
  note.priority:
    displayName: Priority
  note.areas:
    displayName: Areas
  note.created:
    displayName: Started
views:
  - type: table
    name: Active projects
    order:
      - title
      - status
      - priority
      - areas
      - created
