{
  "manifest": 1,
  "name": "bundle-backup",
  "version": "0.1.1",
  "description": "Back up the workspace as a git bundle to a folder (e.g. a synced company drive) after every commit, merge or rewrite — no remote needed",
  "contributes": {
    "claude-md-sections": [
      { "id": "bundle-backup", "path": "fragments/bundle-backup.md" }
    ],
    "git-hooks": [
      { "hook": "post-commit", "script": "git-hooks/bundle-backup.sh" },
      { "hook": "post-merge", "script": "git-hooks/bundle-backup.sh" },
      { "hook": "post-rewrite", "script": "git-hooks/bundle-backup.sh" }
    ],
    "hooks": [
      { "event": "SessionStart", "wrapper": "hooks/status.sh", "command": "bundle-backup status" }
    ]
  }
}
